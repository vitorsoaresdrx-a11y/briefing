NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_EMAILS=

TRANSCRIBE_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=

# Briefing por voz (Gemini Live API) — opcional. Sem isso, só o briefing em
# texto funciona; com isso, a rota /api/briefing/[token]/voice-token liga.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# Timbre da voz (opcional; vazio = voz padrão do Google). Nem toda voz da
# lista de TTS é aceita pela Live API — prefira as clássicas: Aoede, Puck,
# Kore, Charon, Fenrir, Leda. Se a sessão cair ao ligar uma voz, ela é
# rejeitada neste modelo: volte para vazio.
GEMINI_LIVE_VOICE=
# Entonação adaptativa ao tom do cliente (opcional; 1 = liga). Também pode
# ser rejeitada dependendo do modelo — mesma regra acima.
# GEMINI_LIVE_AFFECTIVE=1
